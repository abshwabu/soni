APP_NAME="Soni Perfume"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite databases must use absolute paths
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/soni-perfume/database/database.sqlite
QUEUE_DB_DATABASE=/var/www/soni-perfume/database/queue.sqlite
DB_CACHE_CONNECTION=queue_db
DB_CACHE_LOCK_CONNECTION=queue_db
DB_QUEUE_CONNECTION=queue_db
SESSION_CONNECTION=queue_db

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@soniperfume.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Admin credentials
ADMIN_NAME="Admin"
ADMIN_EMAIL=admin@soniperfume.com
ADMIN_PASSWORD=password

# Telegram & Store configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
STORE_PHONE="+251911000000"
STORE_WHATSAPP="+251911000000"
STORE_ADDRESS="Bole Medhanialem, Addis Ababa, Ethiopia"
STORE_CURRENCY=ETB
